{
  "name": "finance-excel-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive, auto-graded Excel labs for FP&A: variance analysis, reconciliations, forecasting.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiaxingxue/finance-excel-labs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "extract": "node scripts/extract-content.ts",
    "build": "tsc -b && vite build",
    "build:pages": "cross-env BASE_PATH=/finance-excel-labs/ npm run build",
    "preview": "vite preview",
    "preview:pages": "cross-env BASE_PATH=/finance-excel-labs/ vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots:m2": "cross-env SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts",
    "screenshots:m3": "cross-env SCREENSHOTS=1 playwright test tests/e2e/m3-screenshots.spec.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "notices": "node scripts/generate-notices.ts",
    "verification:write": "node scripts/write-verification.ts"
  },
  "dependencies": {
    "hyperformula": "^3.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "ssf": "^0.11.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
